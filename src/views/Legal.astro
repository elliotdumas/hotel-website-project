---
import { getEntry, render } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { useTranslations, type Locale } from '@/i18n/config';
import { url } from '@/i18n/routes';

interface Props {
  locale: Locale;
  page: 'terms' | 'privacy';
}

const { locale, page } = Astro.props;
const t = useTranslations(locale);
const p = t.pages[page];
const entryId = page === 'terms' ? 'conditions-generales-de-vente' : 'politique-de-confidentialite';
const entry = await getEntry('legal', entryId);
if (!entry) throw new Error(`Texte légal introuvable : ${entryId}`);
const { Content } = await render(entry);
---

<BaseLayout locale={locale} page={page} title={p.title} description={p.description}>
  <div class="bg-nuit pt-28 pb-12 text-ivoire md:pt-36">
    <div class="mx-auto max-w-3xl px-4 sm:px-6">
      <nav
        aria-label={t.a11y.breadcrumb}
        class="mb-6 text-xs tracking-[0.14em] text-ivoire/80 uppercase"
      >
        <a href={url('home', locale)} class="hover:underline">
          {t.nav.home}
        </a>
        <span aria-hidden="true"> / </span>
        <span aria-current="page">{p.title}</span>
      </nav>
      <h1 class="text-4xl sm:text-5xl">{p.title}</h1>
    </div>
  </div>
  <article class="prose-legal mx-auto max-w-3xl px-4 py-16 sm:px-6" lang="fr">
    {t.legal.frenchOnly && (
      <p class="font-medium" lang={locale}>
        {t.legal.frenchOnly}
      </p>
    )}
    <Content />
  </article>
</BaseLayout>
