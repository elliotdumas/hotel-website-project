---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHero from '@/components/PageHero.astro';
import SectionHeading from '@/components/SectionHeading.astro';
import CheckList from '@/components/CheckList.astro';
import Gallery from '@/components/Gallery.astro';
import ContactForm from '@/components/ContactForm.astro';
import { format, pick, useTranslations, type Locale } from '@/i18n/config';
import { photos } from '@/data/photos';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
const p = t.pages.seminars;

// Capacités relevées sur le site actuel (page Séminaires).
const meetingRooms = [
  { name: `${p.table.room} 1`, size: 36, classroom: '12 – 15', theatre: '40' },
  { name: `${p.table.room} 2`, size: 30, classroom: '10 – 15', theatre: '30' },
];
const gallery = [photos.salle2, photos.salle3, photos.buffet, photos.jardin];
---

<BaseLayout
  locale={locale}
  page="seminars"
  title={p.title}
  description={p.description}
  image={photos.salle1.src}
>
  <PageHero
    locale={locale}
    image={photos.salle1.src}
    alt={pick(photos.salle1.alt, locale)}
    eyebrow={t.nav.seminars}
    title={p.heroTitle}
    text={p.heroText}
  >
    <a href="#form-seminaire" class="btn btn-primary mt-8">
      {t.cta.requestQuote}
    </a>
  </PageHero>

  <section class="py-20 md:py-28">
    <div class="mx-auto grid max-w-7xl grid-cols-1 gap-12 px-4 sm:px-6 lg:grid-cols-12 lg:px-8">
      <div class="space-y-4 text-lg text-taupe lg:col-span-7" data-reveal>
        {p.intro.map((paragraph) => (
          <p>{paragraph}</p>
        ))}
      </div>
      <div class="lg:col-span-5">
        <SectionHeading title={p.includedTitle} />
        <CheckList items={p.includedList} class="mt-8 text-sm" />
        <h3 class="eyebrow mt-10 text-encre">{p.extraTitle}</h3>
        <p class="mt-3 text-sm text-taupe">{p.extraText}</p>
      </div>
    </div>
  </section>

  <section aria-labelledby="salles-titre" class="bg-nuit py-20 text-ivoire md:py-24">
    <div class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8">
      <SectionHeading title={p.roomsTitle} tone="dark" id="salles-titre" />
      <div class="mt-10 overflow-x-auto">
        <table class="w-full min-w-[32rem] text-left">
          <thead>
            <tr class="border-b border-ivoire/20">
              {[p.table.room, p.table.size, p.table.classroom, p.table.theatre].map((heading) => (
                <th scope="col" class="eyebrow py-3 pr-4 font-medium text-or">
                  {heading}
                </th>
              ))}
            </tr>
          </thead>
          <tbody>
            {meetingRooms.map((room) => (
              <tr class="border-b border-ivoire/10">
                <th scope="row" class="py-4 pr-4 font-serif text-2xl font-medium">
                  {room.name}
                </th>
                <td class="py-4 pr-4">{format(t.room.sizeValue, { size: room.size })}</td>
                <td class="py-4 pr-4">{format(p.table.people, { n: room.classroom })}</td>
                <td class="py-4 pr-4">{format(p.table.people, { n: room.theatre })}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <section class="py-16 md:py-20" aria-label={t.nav.gallery}>
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <Gallery
        locale={locale}
        label={p.title}
        photos={gallery.map((photo) => ({ src: photo.src, alt: pick(photo.alt, locale) }))}
      />
    </div>
  </section>

  <section aria-labelledby="devis-titre" class="bg-sable py-20 md:py-28">
    <div class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8">
      <SectionHeading title={p.formTitle} id="devis-titre" />
      <div class="mt-10">
        <ContactForm locale={locale} variant="seminar" />
      </div>
    </div>
  </section>
</BaseLayout>
