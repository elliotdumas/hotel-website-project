---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHero from '@/components/PageHero.astro';
import SectionHeading from '@/components/SectionHeading.astro';
import StorySection from '@/components/StorySection.astro';
import Gallery from '@/components/Gallery.astro';
import Icon from '@/components/Icon.astro';
import { pick, useTranslations, type Locale } from '@/i18n/config';
import { photos } from '@/data/photos';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
const p = t.pages.bar;
const barPhotos = [
  photos.barPanorama,
  photos.barSuspensions,
  photos.tireuses,
  photos.barLumieres,
  photos.barVueLongue,
  photos.barSalle,
  photos.salonCheminee,
];
---

<BaseLayout
  locale={locale}
  page="bar"
  title={p.title}
  description={p.description}
  image={photos.barComptoir.src}
>
  <PageHero
    locale={locale}
    image={photos.barNuit.src}
    alt={pick(photos.barNuit.alt, locale)}
    eyebrow={t.nav.bar}
    title={p.heroTitle}
    text={p.heroText}
  />

  <section aria-labelledby="entracte-titre" class="py-20 md:py-28">
    <div class="mx-auto grid max-w-7xl grid-cols-1 gap-12 px-4 sm:px-6 lg:grid-cols-12 lg:px-8">
      <div class="lg:col-span-7" data-reveal>
        <SectionHeading title={p.title} id="entracte-titre" />
        <div class="mt-8 space-y-4 text-lg text-taupe">
          {p.text.map((paragraph) => (
            <p>{paragraph}</p>
          ))}
        </div>
      </div>
      <aside class="self-start bg-nuit p-8 text-ivoire lg:col-span-4 lg:col-start-9">
        <Icon name="clock" class="size-8 text-or" />
        <h2 class="mt-4 text-3xl">{p.hoursTitle}</h2>
        <p class="mt-3 text-ivoire/85">{p.hours}</p>
        <a href="/docs/carte-bar-entracte.pdf" class="btn btn-primary mt-8 w-full">
          <Icon name="file" class="size-4" />
          {t.cta.downloadMenu}
        </a>
      </aside>
    </div>
  </section>

  <section class="pb-20" aria-label={t.nav.gallery}>
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <Gallery
        locale={locale}
        label={p.title}
        photos={barPhotos.map((photo) => ({ src: photo.src, alt: pick(photo.alt, locale) }))}
      />
    </div>
  </section>

  <StorySection
    id="terrasse"
    image={photos.terrasseSoir.src}
    alt={pick(photos.terrasseSoir.alt, locale)}
    eyebrow={p.terraceSubtitle}
    title={p.terraceTitle}
    text={p.terraceText}
  />
</BaseLayout>
