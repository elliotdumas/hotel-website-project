---
import { getCollection } from 'astro:content';
import { Picture } from 'astro:assets';
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHero from '@/components/PageHero.astro';
import BookingForm from '@/components/BookingForm.astro';
import SectionHeading from '@/components/SectionHeading.astro';
import StorySection from '@/components/StorySection.astro';
import RoomCard from '@/components/RoomCard.astro';
import CheckList from '@/components/CheckList.astro';
import Marquee from '@/components/Marquee.astro';
import FeatureGrid from '@/components/FeatureGrid.astro';
import ContactBand from '@/components/ContactBand.astro';
import AccessSection from '@/components/AccessSection.astro';
import { pick, useTranslations, type Locale } from '@/i18n/config';
import { url } from '@/i18n/routes';
import { hotel } from '@/data/hotel';
import { photos } from '@/data/photos';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
const p = t.pages.home;
const rooms = (await getCollection('rooms')).sort((a, b) => a.data.order - b.data.order);
const places = (await getCollection('places'))
  .sort((a, b) => a.data.order - b.data.order)
  .slice(0, 4);

const figures = [
  { value: hotel.rooms, label: p.figures.rooms },
  { value: hotel.roomCategories, label: p.figures.categories },
  { value: hotel.apartments, label: p.figures.apartments },
  { value: '24/7', label: p.figures.reception },
];

const mosaic = [photos.courPavillons, photos.salonCheminee2, photos.portailLogo];
---

<BaseLayout
  locale={locale}
  page="home"
  title={p.title}
  description={p.description}
  image={photos.terrasseCour.src}
>
  <PageHero
    locale={locale}
    image={photos.terrasseCour.src}
    alt={p.heroAlt}
    eyebrow={p.heroEyebrow}
    title={p.heroTitle}
    text={p.heroText}
    size="full"
  >
    <div class="mt-8 flex flex-wrap gap-3 md:hidden">
      <a href={url('rooms', locale)} class="btn btn-outline">
        {t.cta.seeRooms}
      </a>
    </div>
    <div class="mt-10 hidden md:block">
      <BookingForm locale={locale} id="booking-hero" />
    </div>
  </PageHero>

  <!-- Formulaire de réservation sous le visuel sur mobile -->
  <div class="bg-nuit md:hidden">
    <BookingForm locale={locale} id="booking-mobile" />
  </div>

  <!-- Introduction -->
  <section aria-labelledby="intro-titre" class="py-20 md:py-28">
    <div class="mx-auto max-w-3xl px-4 text-center sm:px-6" data-reveal>
      <SectionHeading
        eyebrow={p.introEyebrow}
        title={p.introTitle}
        align="center"
        id="intro-titre"
      />
      <div class="mt-8 space-y-4 text-lg text-taupe">
        {p.introText.map((paragraph) => (
          <p>{paragraph}</p>
        ))}
      </div>
      <a href={url('hotel', locale)} class="link-arrow mt-10 text-or-fonce">
        {p.introLink}
      </a>
    </div>

    <div class="mx-auto mt-16 grid max-w-7xl grid-cols-2 gap-3 px-4 sm:px-6 md:grid-cols-12 lg:px-8">
      <div
        class="col-span-2 aspect-[16/10] overflow-hidden md:col-span-7 md:row-span-2 md:aspect-auto"
        data-reveal="curtain"
      >
        <Picture
          src={mosaic[0].src}
          alt={pick(mosaic[0].alt, locale)}
          widths={[640, 960, 1280]}
          sizes="(min-width: 768px) 58vw, 100vw"
          formats={['avif', 'webp']}
          class="size-full object-cover"
        />
      </div>
      {mosaic.slice(1).map((photo) => (
        <div
          class="aspect-[4/5] overflow-hidden md:col-span-5 md:aspect-[16/11]"
          data-reveal="curtain"
        >
          <Picture
            src={photo.src}
            alt={pick(photo.alt, locale)}
            widths={[400, 640, 900]}
            sizes="(min-width: 768px) 40vw, 50vw"
            formats={['avif', 'webp']}
            class="size-full object-cover"
          />
        </div>
      ))}
    </div>

    <dl
      class="mx-auto mt-16 grid max-w-5xl grid-cols-2 gap-y-10 px-4 text-center sm:px-6 md:grid-cols-4"
      data-stagger="120"
    >
      {figures.map((figure) => (
        <div class="flex flex-col-reverse items-center gap-2">
          <dt class="eyebrow max-w-[12rem] text-taupe">{figure.label}</dt>
          <dd
            class="font-serif text-5xl text-encre sm:text-6xl"
            data-count-to={typeof figure.value === 'number' ? figure.value : undefined}
          >
            {figure.value}
          </dd>
        </div>
      ))}
    </dl>
  </section>

  <Marquee words={p.marquee} />

  <!-- Services en un coup d'œil -->
  <section aria-labelledby="atouts-titre" class="py-20 md:py-28">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 gap-8 lg:grid-cols-12 lg:items-end">
        <div class="lg:col-span-7" data-reveal>
          <SectionHeading eyebrow={p.featuresEyebrow} title={p.featuresTitle} id="atouts-titre" />
        </div>
        <div class="lg:col-span-5">
          <p class="eyebrow text-or-fonce">{p.practicalTitle}</p>
          <dl class="mt-4 grid grid-cols-2 gap-4" data-stagger="80">
            {p.practical.map((item) => (
              <div class="border-l border-or pl-4">
                <dt class="text-xs tracking-widest text-taupe uppercase">{item.label}</dt>
                <dd class="mt-1 font-serif text-xl">{item.value}</dd>
              </div>
            ))}
          </dl>
        </div>
      </div>
      <div class="mt-12">
        <FeatureGrid features={p.features} />
      </div>
    </div>
  </section>

  <!-- Chambres en carrousel -->
  <section aria-labelledby="chambres-titre" class="bg-sable py-20 md:py-28">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="flex flex-col gap-6 md:flex-row md:items-end md:justify-between">
        <div class="max-w-xl">
          <SectionHeading eyebrow={p.roomsEyebrow} title={p.roomsTitle} id="chambres-titre" />
          <p class="mt-6 text-lg text-taupe">{p.roomsText}</p>
        </div>
        <a href={url('rooms', locale)} class="link-arrow shrink-0 text-or-fonce">
          {t.cta.seeAllRooms}
        </a>
      </div>
    </div>
    <div class="mx-auto mt-12 max-w-7xl pl-4 sm:pl-6 lg:px-8">
      <div class="scroller auto-cols-max gap-5 pr-4 pb-4 sm:pr-6 lg:pr-0" data-stagger="110">
        {rooms.map((room) => (
          <RoomCard room={room} locale={locale} />
        ))}
      </div>
    </div>
  </section>

  <!-- Sections empilées : bar, piscine, petit-déjeuner, séminaires -->
  <StorySection
    id="bar"
    image={photos.barComptoir.src}
    alt={pick(photos.barComptoir.alt, locale)}
    eyebrow={p.barEyebrow}
    title={p.barTitle}
    text={p.barText}
    meta={p.barMeta}
    link={{ href: url('bar', locale), label: t.cta.discover }}
  />
  <StorySection
    id="piscine"
    image={photos.piscineTropicale2.src}
    alt={pick(photos.piscineTropicale2.alt, locale)}
    eyebrow={p.poolEyebrow}
    title={p.poolTitle}
    text={p.poolText}
    meta={p.poolMeta}
    link={{ href: url('services', locale), label: t.cta.discover }}
    reverse
  />
  <StorySection
    id="petit-dejeuner"
    image={photos.petitDej2.src}
    alt={pick(photos.petitDej2.alt, locale)}
    eyebrow={p.breakfastEyebrow}
    title={p.breakfastTitle}
    text={p.breakfastText}
    meta={p.breakfastMeta}
    link={{ href: url('services', locale), label: t.cta.discover }}
  />
  <StorySection
    id="seminaires"
    image={photos.salle1.src}
    alt={pick(photos.salle1.alt, locale)}
    eyebrow={p.seminarsEyebrow}
    title={p.seminarsTitle}
    text={p.seminarsText}
    meta={p.seminarsMeta}
    link={{ href: url('seminars', locale), label: t.cta.discover }}
    reverse
  />

  <!-- Côté ville -->
  <section aria-labelledby="ville-titre" class="py-20 md:py-28">
    <div class="mx-auto grid max-w-7xl grid-cols-1 gap-12 px-4 sm:px-6 lg:grid-cols-12 lg:px-8">
      <div class="lg:col-span-5" data-reveal>
        <SectionHeading eyebrow={p.cityEyebrow} title={p.cityTitle} id="ville-titre" />
        <p class="mt-6 text-lg text-taupe">{p.cityText}</p>
        <a href={url('discover', locale)} class="link-arrow mt-8 text-or-fonce">
          {t.nav.discover}
        </a>
      </div>
      <ol class="grid gap-px bg-lin sm:grid-cols-2 lg:col-span-7" data-stagger="100">
        {places.map((place, index) => (
          <li class="bg-creme p-6 sm:p-8">
            <span class="eyebrow text-or-fonce">{String(index + 1).padStart(2, '0')}</span>
            <h3 class="mt-3 text-2xl">{pick(place.data.name, locale)}</h3>
            <p class="mt-2 text-sm text-taupe">{pick(place.data.description, locale)}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <AccessSection locale={locale} />

  <!-- Réserver en direct -->
  <section aria-labelledby="direct-titre" class="bg-brun py-20 text-ivoire md:py-24">
    <div class="mx-auto grid max-w-7xl grid-cols-1 gap-12 px-4 sm:px-6 lg:grid-cols-2 lg:items-center lg:px-8">
      <div data-reveal="left">
        <SectionHeading title={p.directTitle} tone="dark" id="direct-titre" />
        <CheckList items={p.directPerks} tone="dark" class="mt-8 text-lg" />
      </div>
      <div data-reveal="right">
        <BookingForm locale={locale} variant="card" id="booking-direct" />
      </div>
    </div>
  </section>

  <ContactBand locale={locale} />
</BaseLayout>
