---
import type { ImageMetadata } from 'astro';
import { Picture } from 'astro:assets';

interface Props {
  image: ImageMetadata;
  alt: string;
  eyebrow?: string;
  title: string;
  text: string;
  meta?: string;
  link?: { href: string; label: string };
  /** Image à droite sur grand écran */
  reverse?: boolean;
  tone?: 'dark' | 'light';
  id?: string;
}

const {
  image,
  alt,
  eyebrow,
  title,
  text,
  meta,
  link,
  reverse = false,
  tone = 'dark',
  id,
} = Astro.props;
const headingId = id ? `${id}-titre` : undefined;
---

<section
  id={id}
  aria-labelledby={headingId}
  class:list={[tone === 'dark' ? 'bg-nuit text-ivoire' : 'bg-creme text-encre']}
>
  <div class="mx-auto grid max-w-7xl grid-cols-1 lg:grid-cols-12 lg:items-center lg:gap-12 lg:px-8 lg:py-20">
    <div
      class:list={[
        'relative aspect-[4/3] overflow-hidden lg:col-span-7 lg:aspect-[5/4]',
        reverse && 'lg:order-2',
      ]}
    >
      <Picture
        src={image}
        alt={alt}
        widths={[480, 768, 1024, 1440]}
        sizes="(min-width: 1024px) 55vw, 100vw"
        formats={['avif', 'webp']}
        class="size-full object-cover transition-transform duration-[1.5s] ease-(--ease-scene) hover:scale-[1.03]"
      />
    </div>
    <div class="px-4 py-12 sm:px-6 lg:col-span-5 lg:px-0 lg:py-0" data-reveal>
      {eyebrow && (
        <p class:list={['eyebrow mb-4', tone === 'dark' ? 'text-or' : 'text-or-fonce']}>
          {eyebrow}
        </p>
      )}
      <h2 id={headingId} class="text-4xl sm:text-5xl">
        {title}
      </h2>
      <span class="rule mt-6" aria-hidden="true"></span>
      <p
        class:list={[
          'mt-6 text-base sm:text-lg',
          tone === 'dark' ? 'text-ivoire/85' : 'text-taupe',
        ]}
      >
        {text}
      </p>
      {meta && (
        <p class:list={['mt-4 text-sm', tone === 'dark' ? 'text-ivoire/70' : 'text-taupe']}>
          {meta}
        </p>
      )}
      {link && (
        <a
          href={link.href}
          class:list={['link-arrow mt-8', tone === 'dark' ? 'text-or' : 'text-or-fonce']}
        >
          {link.label}
        </a>
      )}
      <slot />
    </div>
  </div>
</section>
