---
import type { ImageMetadata } from 'astro';
import { Picture } from 'astro:assets';
import { useTranslations, type Locale } from '@/i18n/config';
import { url } from '@/i18n/routes';

interface Props {
  locale: Locale;
  image: ImageMetadata;
  alt: string;
  title: string;
  text?: string;
  eyebrow?: string;
  /** `full` : plein écran (accueil) ; `page` : bandeau des pages intérieures */
  size?: 'full' | 'page';
  breadcrumb?: boolean;
}

const { locale, image, alt, title, text, eyebrow, size = 'page', breadcrumb = true } = Astro.props;
const t = useTranslations(locale);
---

<section
  class:list={[
    'relative isolate flex overflow-hidden bg-nuit text-ivoire',
    size === 'full' ? 'min-h-[100svh] items-end' : 'min-h-[62svh] items-end md:min-h-[70svh]',
  ]}
>
  <div class="absolute inset-0 -z-10 overflow-hidden">
    <div class="size-full" data-parallax="0.12">
      <Picture
        src={image}
        alt={alt}
        widths={[640, 960, 1280, 1600, 1920, 2000]}
        sizes="100vw"
        formats={['avif', 'webp']}
        loading="eager"
        fetchpriority="high"
        class="hero-kenburns size-full object-cover"
      />
    </div>
  </div>
  <div
    class="absolute inset-0 -z-10 bg-linear-to-b from-nuit/70 via-nuit/25 to-nuit/85"
    aria-hidden="true"
  ></div>

  <div
    class:list={[
      'hero-intro mx-auto w-full max-w-7xl px-4 sm:px-6 lg:px-8',
      size === 'full' ? 'pt-32 pb-24 md:pb-10' : 'pt-32 pb-12 md:pb-16',
    ]}
  >
    {breadcrumb && size === 'page' && (
      <nav
        aria-label={t.a11y.breadcrumb}
        class="mb-6 text-xs tracking-[0.14em] text-ivoire/80 uppercase"
      >
        <ol class="flex flex-wrap items-center gap-2">
          <li>
            <a href={url('home', locale)} class="hover:underline">
              {t.nav.home}
            </a>
          </li>
          <li aria-hidden="true">/</li>
          <li aria-current="page">{title}</li>
        </ol>
      </nav>
    )}
    {eyebrow && <p class="eyebrow mb-4 text-ivoire/90">{eyebrow}</p>}
    <h1
      class:list={[
        'max-w-4xl text-ivoire',
        size === 'full' ? 'text-5xl sm:text-6xl lg:text-7xl' : 'text-5xl sm:text-6xl',
      ]}
    >
      {title}
    </h1>
    {text && <p class="mt-5 max-w-2xl text-lg text-ivoire/90 sm:text-xl">{text}</p>}
    <slot />
  </div>
</section>
