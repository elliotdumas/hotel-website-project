---
import Icon from './Icon.astro';
import PhoneLinks from './PhoneLinks.astro';
import SocialLinks from './SocialLinks.astro';
import { useTranslations, type Locale } from '@/i18n/config';
import { url } from '@/i18n/routes';
import { hotel } from '@/data/hotel';

/** Bloc de fin de page : réservation par téléphone, e-mail et réseaux sociaux. */
interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
const p = t.pages.home;
---

<section aria-labelledby="contact-band-titre" class="bg-nuit py-20 text-ivoire md:py-28">
  <div class="mx-auto grid max-w-7xl grid-cols-1 gap-14 px-4 sm:px-6 lg:grid-cols-12 lg:px-8">
    <div class="lg:col-span-7" data-reveal="left">
      <p class="eyebrow text-or">{p.contactEyebrow}</p>
      <h2 id="contact-band-titre" class="mt-4 text-4xl sm:text-5xl">
        {p.contactTitle}
      </h2>
      <span class="rule mt-6" aria-hidden="true"></span>
      <p class="mt-6 max-w-xl text-lg text-ivoire/85">{p.contactText}</p>
      <h3 class="eyebrow mt-10 text-ivoire/70">{t.booking.phoneTitle}</h3>
      <PhoneLinks locale={locale} tone="dark" class="mt-4" />
      <ul class="mt-8 space-y-2 text-ivoire/85">
        <li>
          <a
            href={`mailto:${hotel.email}`}
            class="inline-flex min-h-11 items-center gap-3 hover:underline"
          >
            <Icon name="mail" class="size-5 text-or" />
            {hotel.email}
          </a>
        </li>
        <li>
          <a
            href={hotel.mapsUrl}
            rel="noopener"
            class="inline-flex min-h-11 items-center gap-3 hover:underline"
          >
            <Icon name="pin" class="size-5 text-or" />
            {`${hotel.address.street}, ${hotel.address.postalCode} ${hotel.address.city}`}
          </a>
        </li>
      </ul>
      <a href={url('contact', locale)} class="link-arrow mt-6 text-or">
        {t.cta.contactUs}
      </a>
    </div>

    <div class="lg:col-span-5" data-reveal="right">
      <div class="border border-ivoire/15 p-8 sm:p-10">
        <Icon name="instagram" class="size-8 text-or" />
        <h3 class="mt-4 text-3xl">{p.followTitle}</h3>
        <p class="mt-3 text-ivoire/80">{p.followText}</p>
        <SocialLinks tone="dark" withLabels class="mt-8" />
        <p class="mt-6 text-sm text-ivoire/60">#LesCoulissesDuThéâtre · #HôtelDeCharme</p>
      </div>
    </div>
  </div>
</section>
