---
import Gallery from './Gallery.astro';
import Icon from './Icon.astro';
import CheckList from './CheckList.astro';
import PhoneLinks from './PhoneLinks.astro';
import { format, pick, useTranslations, type Locale, type Localized } from '@/i18n/config';
import { url } from '@/i18n/routes';
import { hotel } from '@/data/hotel';
import type { ImageMetadata } from 'astro';

/** Fiche détaillée d'une chambre ou d'un appartement. */
interface Props {
  locale: Locale;
  id: string;
  name: Localized;
  tagline?: Localized;
  size: string;
  guests: Localized;
  bed?: Localized;
  priceFrom?: number;
  priceNote?: Localized;
  description: Localized[];
  amenities: string[];
  highlight?: Localized;
  noPets?: boolean;
  photos: { src: ImageMetadata; alt: Localized }[];
  /** Mention affichée à la place du prix (appartements) */
  availability?: string;
  index: number;
}

const {
  locale,
  id,
  name,
  tagline,
  size,
  guests,
  bed,
  priceFrom,
  priceNote,
  description,
  amenities,
  highlight,
  noPets,
  photos,
  availability,
  index,
} = Astro.props;
const t = useTranslations(locale);
const title = pick(name, locale);
const bookHref = hotel.bookingUrl ?? url('contact', locale, 'reserver');
const amenityLabels = amenities.map((key) => t.amenities[key as keyof typeof t.amenities]);
---

<section
  id={id}
  aria-labelledby={`${id}-titre`}
  class:list={['scroll-mt-24 py-16 md:py-24', index % 2 === 1 ? 'bg-sable' : 'bg-creme']}
>
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 gap-10 lg:grid-cols-12">
      <div class="lg:col-span-5" data-reveal="left">
        <p class="eyebrow text-or-fonce">{String(index + 1).padStart(2, '0')}</p>
        <h2 id={`${id}-titre`} class="mt-3 text-4xl sm:text-5xl">
          {title}
        </h2>
        {tagline && (
          <p class="mt-3 font-serif text-xl text-taupe italic">{pick(tagline, locale)}</p>
        )}
        <span class="rule mt-6" aria-hidden="true"></span>

        <dl class="mt-8 grid grid-cols-2 gap-x-6 gap-y-4 text-sm sm:grid-cols-3 lg:grid-cols-2 xl:grid-cols-3">
          <div>
            <dt class="eyebrow flex items-center gap-2 text-taupe">
              <Icon name="ruler" class="size-4" />
              {t.room.size}
            </dt>
            <dd class="mt-1 text-base">{format(t.room.sizeValue, { size })}</dd>
          </div>
          <div>
            <dt class="eyebrow flex items-center gap-2 text-taupe">
              <Icon name="users" class="size-4" />
              {t.room.guests}
            </dt>
            <dd class="mt-1 text-base">{pick(guests, locale)}</dd>
          </div>
          {bed && (
            <div class="col-span-2 sm:col-span-1 lg:col-span-2 xl:col-span-1">
              <dt class="eyebrow flex items-center gap-2 text-taupe">
                <Icon name="bed" class="size-4" />
                {t.room.bed}
              </dt>
              <dd class="mt-1 text-base">{pick(bed, locale)}</dd>
            </div>
          )}
        </dl>

        {priceFrom !== undefined && (
          <p class="mt-8">
            <span class="text-sm text-taupe">{t.room.from}</span>{' '}
            <span class="font-serif text-4xl">{priceFrom} €</span>{' '}
            <span class="text-sm text-taupe">{t.room.perNight}</span>
            {priceNote && (
              <span class="mt-1 block text-sm text-taupe">{pick(priceNote, locale)}</span>
            )}
          </p>
        )}
        {availability && <p class="mt-8 font-serif text-xl">{availability}</p>}

        <div class="mt-6">
          <a href={bookHref} class="btn btn-primary">
            {priceFrom !== undefined ? t.cta.bookThisRoom : t.cta.askAvailability}
          </a>
          <p class="mt-5 text-sm text-taupe">{t.booking.phoneTitle}</p>
          <PhoneLinks locale={locale} class="mt-2" />
        </div>
      </div>

      <div class="lg:col-span-7" data-reveal="right">
        <div class="space-y-4 text-base text-taupe sm:text-lg">
          {description.map((paragraph) => (
            <p>{pick(paragraph, locale)}</p>
          ))}
        </div>
        {highlight && (
          <p class="mt-6 inline-flex items-center gap-2 border border-or/50 px-4 py-2 text-sm">
            <Icon name="check" class="size-4 text-or-fonce" />
            {pick(highlight, locale)}
          </p>
        )}
        <h3 class="eyebrow mt-8 text-encre">{t.room.amenities}</h3>
        <CheckList items={amenityLabels} columns={2} class="mt-4 text-sm" />
        {noPets && <p class="mt-6 text-sm text-taupe italic">{t.room.noPets}</p>}
      </div>
    </div>

    <div class="mt-12">
      <Gallery
        locale={locale}
        label={format(t.room.photos, { name: title })}
        photos={photos.map((photo) => ({ src: photo.src, alt: pick(photo.alt, locale) }))}
      />
    </div>
  </div>
</section>
