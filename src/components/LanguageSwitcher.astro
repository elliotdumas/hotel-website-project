---
import { locales, localeNames, useTranslations, type Locale } from '@/i18n/config';
import { url, type PageKey } from '@/i18n/routes';

interface Props {
  locale: Locale;
  page: PageKey;
  class?: string;
}

const { locale, page, class: className } = Astro.props;
const t = useTranslations(locale);
---

<nav aria-label={t.a11y.language} class={className}>
  <ul class="flex items-center gap-1 text-xs font-medium tracking-[0.14em] uppercase">
    {locales.map((l) => (
      <li>
        <a
          href={url(page, l)}
          hreflang={l}
          lang={l}
          aria-current={l === locale ? 'true' : undefined}
          title={localeNames[l]}
          class:list={[
            'inline-flex min-h-11 min-w-11 items-center justify-center px-1 transition-opacity',
            l === locale
              ? 'underline decoration-or underline-offset-4'
              : 'opacity-75 hover:opacity-100',
          ]}
        >
          <span class="sr-only">{localeNames[l]}</span>
          <span aria-hidden="true">{l}</span>
        </a>
      </li>
    ))}
  </ul>
</nav>
