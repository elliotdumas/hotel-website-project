---
import { Image, getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { useTranslations, type Locale } from '@/i18n/config';

interface Props {
  locale: Locale;
  photos: { src: ImageMetadata; alt: string }[];
  /** `scroller` : bande horizontale ; `grid` : mosaïque */
  layout?: 'scroller' | 'grid';
  label: string;
}

const { locale, photos, layout = 'scroller', label } = Astro.props;
const t = useTranslations(locale);

// Version grand format pour la visionneuse (le lien fonctionne aussi sans JavaScript).
const items = await Promise.all(
  photos.map(async (photo) => ({
    ...photo,
    large: (await getImage({ src: photo.src, width: 1600, format: 'webp' })).src,
  })),
);
---

<div class="gallery" data-gallery data-label-of={t.a11y.photoOf}>
  <ul
    aria-label={label}
    class:list={[
      layout === 'scroller'
        ? 'scroller auto-cols-[82%] gap-3 pb-3 sm:auto-cols-[46%] lg:auto-cols-[31%]'
        : 'columns-2 gap-3 md:columns-3 lg:columns-4 [&>li]:mb-3 [&>li]:break-inside-avoid',
    ]}
  >
    {items.map((photo, index) => (
      <li>
        <a
          href={photo.large}
          class="group relative block overflow-hidden bg-sable"
          data-index={index}
          data-full={photo.large}
          data-alt={photo.alt}
        >
          <Image
            src={photo.src}
            alt={photo.alt}
            widths={[400, 640, 900]}
            sizes={
              layout === 'scroller'
                ? '(min-width: 1024px) 31vw, (min-width: 640px) 46vw, 82vw'
                : '(min-width: 1024px) 25vw, (min-width: 768px) 33vw, 50vw'
            }
            class:list={[
              'w-full object-cover transition-transform duration-700 group-hover:scale-105',
              layout === 'scroller' && 'aspect-[3/2]',
            ]}
          />
        </a>
      </li>
    ))}
  </ul>
</div>

<dialog
  class="lightbox m-0 h-dvh max-h-none w-screen max-w-none bg-nuit/95 p-0 text-ivoire backdrop:bg-nuit/80"
  aria-label={label}
>
  <figure class="flex h-full flex-col items-center justify-center gap-3 px-4 py-16">
    <img alt="" class="max-h-[80dvh] max-w-full object-contain" data-lightbox-img />
    <figcaption
      class="max-w-2xl text-center text-sm text-ivoire/80"
      data-lightbox-caption
    ></figcaption>
  </figure>
  <button
    type="button"
    class="absolute top-3 right-3 inline-flex size-12 items-center justify-center text-3xl"
    data-lightbox-close
    aria-label={t.a11y.close}
  >
    ×
  </button>
  <button
    type="button"
    class="absolute top-1/2 left-2 inline-flex size-12 -translate-y-1/2 items-center justify-center text-3xl"
    data-lightbox-prev
    aria-label={t.a11y.previous}
  >
    ‹
  </button>
  <button
    type="button"
    class="absolute top-1/2 right-2 inline-flex size-12 -translate-y-1/2 items-center justify-center text-3xl"
    data-lightbox-next
    aria-label={t.a11y.next}
  >
    ›
  </button>
  <p
    class="absolute bottom-4 left-1/2 -translate-x-1/2 text-xs tracking-widest"
    data-lightbox-count
  ></p>
</dialog>

<script>
  // Visionneuse photo accessible basée sur <dialog> (amélioration progressive).
  import { format } from '@/i18n/format';

  document.querySelectorAll<HTMLElement>('[data-gallery]').forEach((gallery) => {
    const dialog = gallery.nextElementSibling as HTMLDialogElement | null;
    if (!dialog || typeof dialog.showModal !== 'function') return;
    const links = Array.from(gallery.querySelectorAll<HTMLAnchorElement>('a[data-full]'));
    const img = dialog.querySelector<HTMLImageElement>('[data-lightbox-img]')!;
    const caption = dialog.querySelector<HTMLElement>('[data-lightbox-caption]')!;
    const count = dialog.querySelector<HTMLElement>('[data-lightbox-count]')!;
    const labelOf = gallery.dataset.labelOf ?? '{current} / {total}';
    let current = 0;

    const show = (index: number) => {
      current = (index + links.length) % links.length;
      const link = links[current];
      img.src = link.dataset.full ?? link.href;
      img.alt = link.dataset.alt ?? '';
      caption.textContent = link.dataset.alt ?? '';
      count.textContent = format(labelOf, { current: current + 1, total: links.length });
    };

    links.forEach((link, index) =>
      link.addEventListener('click', (event) => {
        event.preventDefault();
        show(index);
        dialog.showModal();
      }),
    );
    dialog.querySelector('[data-lightbox-close]')?.addEventListener('click', () => dialog.close());
    dialog
      .querySelector('[data-lightbox-prev]')
      ?.addEventListener('click', () => show(current - 1));
    dialog
      .querySelector('[data-lightbox-next]')
      ?.addEventListener('click', () => show(current + 1));
    dialog.addEventListener('keydown', (event) => {
      if (event.key === 'ArrowLeft') show(current - 1);
      if (event.key === 'ArrowRight') show(current + 1);
    });
    dialog.addEventListener('click', (event) => {
      if (event.target === dialog) dialog.close();
    });
    dialog.addEventListener('close', () => links[current]?.focus());
  });
</script>
